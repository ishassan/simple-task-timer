{
  "name": "simple-task-timer-firebase",
  "private": true,
  "license": "GPL-3.0-or-later",
  "scripts": {
    "test": "firebase emulators:exec --project demo-simple-task-timer --only auth,firestore \"node --test --test-concurrency=1 emulator/rules.js emulator/sync.js\"",
    "deploy-rules": "firebase deploy --only firestore:rules",
    "bundle": "esbuild bundle-entry.js --bundle --format=iife --global-name=FirebaseLib --minify --legal-comments=external --target=firefox140,safari17 --outfile=../src/lib/firebase.js"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "esbuild": "0.28.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.32.1"
  }
}
