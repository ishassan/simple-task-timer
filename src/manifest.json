{
  "manifest_version": 3,
  "name": "Simple Task Timer",
  "description": "Time your tasks with one click. Pause, reset, mark done, and get an alert when a task reaches its goal.",
  "version": "4.0.0",
  "author": "Islam Hassan",
  "permissions": ["storage", "alarms"],
  "optional_permissions": ["notifications"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Simple Task Timer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "scripts": ["tasks.js", "store.js", "background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{5f590989-34a7-4c7a-b219-5de25a64db43}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
